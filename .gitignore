node_modules/
dist/
target/

# Spike output — regenerated by npm run spike:*
spikes/out/

# Bundled sidecar binaries — fetched, not committed. ~15 MB, and git would keep
# every released version forever. Run: npm run fetch:sidecar
src-tauri/binaries/

# Never commit real medical documents. Fixtures are synthetic only.
tests/fixtures/real/
vault/

.DS_Store
Thumbs.db

# Generated by `tauri android init` and rewritten on every build. The parts that
# carry real decisions — permissions, intent filters — live in the tracked
# manifest under gen/android/app/src/main.
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea/

# The phone front end, built by npm run build:mobile
dist-mobile/

# Google OAuth client downloads. These belong on the machine, never in the repo.
client_secret_*.json
